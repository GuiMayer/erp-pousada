# Desenvolvimento local: copie para .env. Não versionar credenciais reais.
DATABASE_URL="postgresql://pousada_dev:local-development-only@localhost:5432/pousada_dev"
NEXT_PUBLIC_DATA_ADAPTER="database"
APP_URL="http://localhost:3000"
# Defina no ambiente apenas durante o primeiro cadastro; mínimo de 12 caracteres.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Produção (Compose): senha forte, com caracteres seguros para URL.
POSTGRES_PASSWORD=""
BACKUP_HOST_DIR="./backups"
BACKUP_INTERVAL_MINUTES="30"
BACKUP_RETENTION_DAYS="14"
