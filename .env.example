BACKUP_HOST_DIR="./backups"
BACKUP_INTERVAL_MINUTES="30"
BACKUP_RETENTION_DAYS="14"
DOMAIN="localhost"
LAN_BIND_ADDRESS="127.0.0.1"
BACKUP_REMOTE=""
ALERT_WEBHOOK_URL=""
