    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:migrate-local-data": "tsx scripts/migrate-local-data.ts",
    "db:reset": "prisma migrate reset",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:logs": "docker compose -f compose.dev.yml logs -f",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "db:reset-admin": "tsx scripts/reset-admin.ts"
  },
